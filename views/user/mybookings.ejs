<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Bookings | WonderLust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="icon" href="https://scrnshts.club/wp-content/uploads/2022/05/ico.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #ff385c;
      --dark: #222222;
      --light: #f7f7f7;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--light);
      margin: 0;
      padding: 0;
    }

    .bookings-container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .page-header {
      margin-bottom: 40px;
    }

    .booking-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      margin-bottom: 25px;
      overflow: hidden;
      border: 1px solid rgba(0,0,0,0.05);
      transition: transform 0.2s ease;
    }

    .booking-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .booking-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .booking-details {
      padding: 20px;
    }

    .status-badge {
      font-size: 0.8rem;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 50px;
      text-transform: uppercase;
    }

    .status-confirmed {
      background: rgba(40, 167, 69, 0.1);
      color: #28a745;
    }

    .status-pending {
      background: rgba(255, 193, 7, 0.1);
      color: #ffc107;
    }

    .utr-tag {
      font-family: monospace;
      background: #f1f1f1;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 0.9rem;
    }

    .empty-state {
      text-align: center;
      padding: 100px 20px;
      background: white;
      border-radius: 24px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .empty-icon {
      font-size: 60px;
      color: #ddd;
      margin-bottom: 20px;
    }

    .price-tag {
      color: var(--primary);
      font-weight: 700;
      font-size: 1.2rem;
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>

  <div class="bookings-container">
    <div class="page-header">
      <h1 class="fw-bold">My Bookings</h1>
      <p class="text-muted">Manage your stays and view transaction history</p>
    </div>

    <% if (bookings.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><i class="fas fa-suitcase-rolling"></i></div>
        <h3>No bookings yet</h3>
        <p class="text-muted">When you book a stay, it will appear here.</p>
        <a href="/listings" class="btn btn-primary mt-3" style="background-color: var(--primary); border: none; border-radius: 10px; padding: 10px 25px;">
          Explore Listings
        </a>
      </div>
    <% } else { %>
      <div class="row">
        <% bookings.forEach(booking => { %>
          <div class="col-12">
            <div class="booking-card">
              <div class="row g-0">
                <div class="col-md-4">
                  <img src="<%= booking.listing.image.url || booking.listing.image %>" class="booking-img" alt="<%= booking.listing.title %>">
                </div>
                <div class="col-md-8">
                  <div class="booking-details d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <h4 class="fw-bold mb-0"><%= booking.listing.title %></h4>
                      <span class="status-badge status-<%= booking.status.toLowerCase() %>">
                        <%= booking.status %>
                      </span>
                    </div>
                    
                    <p class="text-muted mb-3">
                      <i class="fas fa-map-marker-alt me-1"></i>
                      <%= booking.listing.location %>, <%= booking.listing.country %>
                    </p>

                    <div class="mb-3">
                      <small class="text-muted d-block mb-1">Transaction UTR</small>
                      <span class="utr-tag"><%= booking.utr %></span>
                    </div>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                      <div>
                        <small class="text-muted d-block">Paid Amount</small>
                        <span class="price-tag">₹<%= booking.amount.toLocaleString() %></span>
                      </div>
                      <div class="text-end">
                        <small class="text-muted d-block">Booking Date</small>
                        <span class="fw-600"><%= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                      </div>
                    </div>
                    
                    <div class="mt-3">
                      <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        View Listing
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
