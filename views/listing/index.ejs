            <div class="like-btn-container">
              <a href="/listings/<%= listing._id %>/like" class="like-btn">
                <i
                  class="fas fa-heart <%= (currentUser && currentUser.likedListing && Array.isArray(currentUser.likedListing) && currentUser.likedListing.includes(listing._id.toString())) ? 'liked' : '' %>"
                ></i>
              </a>
            </div>
            <% } %>
            <!-- Wrap image with a link to individual listing page -->
