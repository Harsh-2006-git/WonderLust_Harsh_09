      <%- include('../partials/flash') %>
      <% if (typeof AllListing !== 'undefined' && AllListing && AllListing.length > 0) { %>

      <div class="row">
        <% AllListing.forEach(listing => { %>
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="listing-card position-relative">
            <!-- Edit/Delete Buttons (visible on hover) -->
            <% if(currentUser && listing.owner && currentUser._id.equals(listing.owner._id || listing.owner)){ %>
            <div class="listing-actions">
              <a
                href="/listings/<%= listing._id %>/edit"
                class="action-btn edit-btn"
              >
                <i class="fas fa-edit"></i>
              </a>
              <form
                action="/listings/<%= listing._id %>?_method=DELETE"
                method="POST"
                style="display: inline"
              >
                <button type="submit" class="action-btn delete-btn">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </div>
            <% } %>
            <!-- Like Button (top right corner) -->
