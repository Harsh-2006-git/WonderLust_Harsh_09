<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Book Your Stay | <%= listing.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="icon" href="https://scrnshts.club/wp-content/uploads/2022/05/ico.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    :root {
      --airbnb-red: #ff385c;
      --airbnb-dark: #222222;
      --airbnb-light-gray: #f7f7f7;
    }

    body {
      background-color: var(--airbnb-light-gray);
      font-family: "Inter", sans-serif;
    }

    .booking-container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 20px;
    }

    .card {
      border-radius: 16px;
      border: none;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
      overflow: hidden;
    }

    .listing-summary {
      background: white;
      padding: 25px;
    }

    .listing-img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 15px;
    }

    .payment-section {
      background: white;
      padding: 30px;
      border-left: 1px solid #eee;
    }

    .qr-box {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 15px;
      text-align: center;
      margin-bottom: 20px;
    }

    .qr-image {
      width: 200px;
      height: 200px;
      margin-bottom: 10px;
    }

    .price-badge {
      background: rgba(255, 56, 92, 0.1);
      color: var(--airbnb-red);
      font-weight: 700;
      padding: 8px 15px;
      border-radius: 50px;
      font-size: 1.1rem;
    }

    .btn-confirm {
      background-color: var(--airbnb-red);
      color: white;
      border: none;
      padding: 12px;
      font-weight: 600;
      border-radius: 10px;
      width: 100%;
      margin-top: 20px;
    }

    .btn-confirm:hover {
      background-color: #e61e4d;
      color: white;
    }

    .utr-input {
      letter-spacing: 2px;
      font-weight: 600;
      text-align: center;
      font-size: 1.2rem;
    }

    @media (max-width: 768px) {
      .payment-section {
        border-left: none;
        border-top: 1px solid #eee;
      }
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
  
  <div class="booking-container">
    <div class="mb-4">
      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
        <i class="fas fa-chevron-left me-2"></i>Back to listing
      </a>
      <h2 class="mt-3 fw-bold">Confirm and pay</h2>
    </div>

    <div class="card">
      <div class="row g-0">
        <!-- Left Side: Listing Summary -->
        <div class="col-md-5 listing-summary">
          <img src="<%= listing.image.url || listing.image %>" alt="<%= listing.title %>" class="listing-img" />
          <h5 class="fw-bold"><%= listing.title %></h5>
          <p class="text-muted small mb-3">
            <i class="fas fa-map-marker-alt me-1"></i><%= listing.location %>, <%= listing.country %>
          </p>
          <hr>
          <div class="d-flex justify-content-between mb-2">
            <span>Price per night</span>
            <span>₹<%= listing.price.toLocaleString() %></span>
          </div>
          <div class="d-flex justify-content-between fw-bold mt-3 fs-5">
            <span>Total (INR)</span>
            <span>₹<%= listing.price.toLocaleString() %></span>
          </div>
          <div class="mt-4 alert alert-light border small">
            <i class="fas fa-shield-alt me-2 text-success"></i>
            Your payment is secure and protected by WonderLust.
          </div>
        </div>

        <!-- Right Side: Payment -->
        <div class="col-md-7 payment-section">
          <h4 class="fw-bold mb-4">Select Dates & Pay</h4>
          
          <div class="row mb-4">
            <div class="col-6">
              <label class="form-label small fw-bold text-uppercase text-muted">Check-in</label>
              <input type="date" id="checkIn" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            <div class="col-6">
              <label class="form-label small fw-bold text-uppercase text-muted">Check-out</label>
              <input type="date" id="checkOut" class="form-control" required disabled>
            </div>
          </div>

          <div class="qr-box border">
            <div class="mb-3" id="stayInfo" style="display: none;">
               <span class="badge bg-light text-dark border mb-2"><i class="fas fa-clock me-1"></i> <span id="nightCount">0</span> Nights Stay</span>
               <br>
               <span class="price-badge">Total to Pay: ₹<span id="totalAmount">0</span></span>
            </div>
            <div id="initialPrompt">
               <p class="text-muted">Select dates to generate payment QR</p>
            </div>

            <% 
              const defaultUpi = listing.upiId || '8305721431@axl';
            %>
            <div id="qrContainer" style="display: none;">
              <img src="" id="qrImage" alt="Payment QR" class="qr-image" />
              <p class="mb-0 fw-bold">Scan to Pay via UPI</p>
              <p class="text-muted small">Payable to: <%= defaultUpi %></p>
              <a href="#" id="upiLink" class="btn btn-outline-dark btn-sm mt-2">
                 <i class="fas fa-mobile-alt me-2"></i>Pay via App
              </a>
            </div>
          </div>

          <form action="/listings/<%= listing._id %>/book" method="POST" class="needs-validation" id="bookingForm" novalidate
                data-price="<%= listing.price %>"
                data-upi="<%= listing.upiId || '8305721431@axl' %>"
                data-title="<%= listing.title %>">
            <input type="hidden" name="startDate" id="hiddenStartDate">
            <input type="hidden" name="endDate" id="hiddenEndDate">
            <input type="hidden" name="amount" id="hiddenAmount">

            <div class="mb-3">
              <label for="utr" class="form-label fw-bold">Enter 12-digit UTR / Transaction ID</label>
              <input type="text" class="form-control utr-input" id="utr" name="utr" 
                     pattern="[0-9]{12}" maxlength="12" minlength="12" required
                     placeholder="000000000000" disabled>
              <div class="invalid-feedback">
                Please enter a valid 12-digit transaction ID.
              </div>
            </div>

            <button type="submit" class="btn btn-confirm" id="confirmBtn" disabled>
              <i class="fas fa-check-circle me-2"></i>Confirm Booking
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (() => {
      'use strict'
      const checkIn = document.getElementById('checkIn');
      const checkOut = document.getElementById('checkOut');
      const totalAmountDisp = document.getElementById('totalAmount');
      const nightCountDisp = document.getElementById('nightCount');
      const stayInfo = document.getElementById('stayInfo');
      const initialPrompt = document.getElementById('initialPrompt');
      const qrContainer = document.getElementById('qrContainer');
      const qrImage = document.getElementById('qrImage');
      const upiLink = document.getElementById('upiLink');
      const utrInput = document.getElementById('utr');
      const confirmBtn = document.getElementById('confirmBtn');
      const form = document.getElementById('bookingForm');

      const pricePerNight = parseFloat(form.dataset.price);
      const upiId = form.dataset.upi;
      const listingTitle = form.dataset.title;

      checkIn.addEventListener('change', () => {
        checkOut.disabled = false;
        checkOut.min = new Date(new Date(checkIn.value).getTime() + 86400000).toISOString().split('T')[0];
        calculateTotal();
      });

      checkOut.addEventListener('change', calculateTotal);

      function calculateTotal() {
        if (checkIn.value && checkOut.value) {
          const start = new Date(checkIn.value);
          const end = new Date(checkOut.value);
          const diff = end - start;
          const nights = Math.ceil(diff / (1000 * 60 * 60 * 24));

          if (nights > 0) {
            const total = nights * pricePerNight;
            nightCountDisp.textContent = nights;
            totalAmountDisp.textContent = total.toLocaleString();
            
            // Set hidden fields
            document.getElementById('hiddenStartDate').value = checkIn.value;
            document.getElementById('hiddenEndDate').value = checkOut.value;
            document.getElementById('hiddenAmount').value = total;

            // Show QR logic
            stayInfo.style.display = 'block';
            initialPrompt.style.display = 'none';
            qrContainer.style.display = 'block';
            utrInput.disabled = false;

            const upiUrl = `upi://pay?pa=${upiId}&pn=${encodeURIComponent(listingTitle)}&am=${total}&cu=INR`;
            qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(upiUrl)}`;
            upiLink.href = upiUrl;
          } else {
            resetUI();
          }
        } else {
          resetUI();
        }
      }

      function resetUI() {
        stayInfo.style.display = 'none';
        initialPrompt.style.display = 'block';
        qrContainer.style.display = 'none';
        utrInput.disabled = true;
        confirmBtn.disabled = true;
      }

      utrInput.addEventListener('input', () => {
        utrInput.value = utrInput.value.replace(/[^0-9]/g, '');
        if (utrInput.value.length === 12) {
          confirmBtn.disabled = false;
          utrInput.classList.add('is-valid');
        } else {
          confirmBtn.disabled = true;
          utrInput.classList.remove('is-valid');
        }
      });

      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    })()
  </script>
  <%- include('../partials/footer') %>
</body>
</html>
