<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Your Listing | WonderLust</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="icon" href="https://scrnshts.club/wp-content/uploads/2022/05/ico.png" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --primary: #ff385c;
      --primary-hover: #e61e4d;
      --dark: #222222;
      --light-gray: #f7f7f7;
      --border: #dddddd;
      --text-muted: #717171;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--light-gray);
      color: var(--dark);
      margin: 0;
      padding: 0;
    }

    .form-container {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .form-card {
      background: white;
      border-radius: 24px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
      padding: 40px;
      border: 1px solid rgba(0,0,0,0.05);
    }

    .page-title {
      font-weight: 800;
      font-size: 2.2rem;
      color: var(--dark);
      margin-bottom: 8px;
    }

    .page-subtitle {
      color: var(--text-muted);
      margin-bottom: 40px;
    }

    .section-label {
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      color: var(--primary);
    }

    .section-label i {
      margin-right: 12px;
      background: rgba(255, 56, 92, 0.1);
      padding: 10px;
      border-radius: 12px;
    }

    .form-control, .form-select {
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 12px 16px;
      font-size: 1rem;
      transition: all 0.2s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.1);
    }

    .input-group-text {
      background: var(--light-gray);
      border: 1.5px solid var(--border);
      border-right: none;
      border-radius: 14px 0 0 14px;
      color: var(--dark);
      font-weight: 600;
    }

    .input-group .form-control {
      border-radius: 0 14px 14px 0;
    }

    .btn-update {
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 14px;
      padding: 16px;
      font-weight: 700;
      font-size: 1.1rem;
      width: 100%;
      margin-top: 20px;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-update:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(255, 56, 92, 0.3);
      color: white;
    }

    .btn-cancel {
      display: block;
      text-align: center;
      margin-top: 15px;
      color: var(--text-muted);
      text-decoration: none;
      font-weight: 500;
    }

    .btn-cancel:hover {
      color: var(--dark);
    }

    .char-count {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-align: right;
      margin-top: 4px;
    }

    .was-validated .form-control:invalid {
      border-color: #dc3545;
      background-image: none;
    }

    .invalid-feedback {
      font-size: 0.85rem;
      font-weight: 500;
      margin-left: 5px;
    }

    @media (max-width: 576px) {
      .form-card {
        padding: 25px;
        border-radius: 16px;
      }
      .page-title {
        font-size: 1.8rem;
      }
    }
  </style>
</head>

<body>
  <%- include('../partials/header') %>
  <%- include('../partials/flash') %>

  <div class="form-container">
    <div class="text-center mb-4">
      <h1 class="page-title">Update Your Listing</h1>
      <p class="page-subtitle">Refresh your space's details to attract more guests</p>
    </div>

    <div class="form-card">
      <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" class="needs-validation" novalidate>
        
        <!-- Section 1: Content -->
        <div class="section-label">
          <i class="fas fa-pen-nib"></i>
          Listing Details
        </div>
        
        <div class="mb-4">
          <label class="form-label fw-bold">Title</label>
          <input type="text" name="listing[title]" class="form-control" 
                 value="<%= listing.title %>" required minlength="5">
          <div class="invalid-feedback">A catchy title of at least 5 characters is required.</div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-bold">Description</label>
          <textarea name="listing[description]" class="form-control" rows="4" 
                    required id="descInput"><%= listing.description %></textarea>
          <div class="char-count" id="charCount">0 characters</div>
          <div class="invalid-feedback">Please provide a short description.</div>
        </div>

        <!-- Section 2: Media -->
        <div class="section-label mt-5">
          <i class="fas fa-camera"></i>
          Media
        </div>
        <div class="mb-4">
          <label class="form-label fw-bold">Image URL</label>
          <input type="url" name="listing[image]" class="form-control" 
                 value="<%= listing.image.url || listing.image %>" required>
          <div class="invalid-feedback">Please enter a valid image URL.</div>
        </div>

        <!-- Section 3: Location -->
        <div class="section-label mt-5">
          <i class="fas fa-map-marked-alt"></i>
          Location & Pricing
        </div>
        <div class="row">
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">City/Location</label>
            <input type="text" name="listing[location]" class="form-control" 
                   value="<%= listing.location %>" required>
            <div class="invalid-feedback">City name is required.</div>
          </div>
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">Country</label>
            <input type="text" name="listing[country]" class="form-control" 
                   value="<%= listing.country %>" required>
            <div class="invalid-feedback">Country name is required.</div>
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">Price per night</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="listing[price]" class="form-control" 
                     value="<%= listing.price %>" required min="1">
            </div>
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>
          <div class="col-md-6 mb-4">
            <label class="form-label fw-bold">UPI ID (for payments)</label>
            <input type="text" name="listing[upiId]" class="form-control" 
                   value="<%= listing.upiId %>" required>
            <div class="invalid-feedback">Required for receiving guest payments.</div>
          </div>
        </div>

        <button type="submit" class="btn btn-update mt-4">
          Update Listing
        </button>
        
        <a href="/listings/<%= listing._id %>" class="btn-cancel">Cancel and Go Back</a>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (() => {
      'use strict'
      const forms = document.querySelectorAll('.needs-validation')
      Array.from(forms).forEach(form => {
        form.addEventListener('submit', event => {
          if (!form.checkValidity()) {
            event.preventDefault()
            event.stopPropagation()
          }
          form.classList.add('was-validated')
        }, false)
      })

      const descInput = document.getElementById('descInput');
      const charCount = document.getElementById('charCount');
      
      const updateCount = () => {
        charCount.textContent = `${descInput.value.length} characters`;
      };
      
      descInput.addEventListener('input', updateCount);
      updateCount(); // Initial count
    })()
  </script>
  <%- include('../partials/footer') %>
</body>

</html>